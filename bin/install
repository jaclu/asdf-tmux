#!/usr/bin/env bash

set -euo pipefail

d_brew=$(brew --prefix 2>/dev/null)
[[ -n "$d_brew" ]] && [[ -d "$d_brew" ]] && {
    # Needed for tmux < 3.4 on MacOS..., seemingly harmless for newer versions
    export CPPFLAGS="-I/$d_brew/include"
    export LDFLAGS="-L/$d_brew/lib"
}

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shell check source=lib/utils.bash
# shellcheck source=/dev/null
source "${plugin_dir}/lib/utils.bash"

# shellcheck disable=SC2154 # the ASDF_ variables are defined via asdf
install_version "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"
